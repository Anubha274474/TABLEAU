      <column caption='Female count' datatype='integer' name='[Calculation_0680380208738304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(if[Gender]=&apos;Female&apos;then 1 else 0 END)' />
      </column>
      <column caption='Males Count' datatype='integer' name='[Calculation_0680380209315841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if[Gender]=&apos;Male&apos; THEN 1 else 0 END)' />
