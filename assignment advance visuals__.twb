            <column caption='Admission Date' datatype='date' name='[AdmissionDate]' role='dimension' type='ordinal' />
            <column caption='rank_treatment_cost' datatype='integer' name='[Calculation_0800501701701632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='rank(SUM([TreatmentCost]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Treatment Cost' datatype='real' name='[TreatmentCost]' role='dimension' type='ordinal' />
