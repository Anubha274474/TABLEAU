    <worksheet name='Sheet 5'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Question 4- Create a Butterfly Chart comparing Males
vs Females patient count by Department.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Healthcare_Advanced_Tableau_Ass (Healthcare_Advanced_Tableau_Assignment_Dataset_v2)' name='federated.18ygzuk1d1lhb11ddq2on07s98od' />
          </datasources>
          <datasource-dependencies datasource='federated.18ygzuk1d1lhb11ddq2on07s98od'>
            <column caption='Female count' datatype='integer' name='[Calculation_0680380208738304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if[Gender]=&apos;Female&apos;then 1 else 0 END)' />
            </column>
            <column caption='Males Count' datatype='integer' name='[Calculation_0680380209315841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if[Gender]=&apos;Male&apos; THEN 1 else 0 END)' />
            </column>
            <column caption='-SUM([Female count])' datatype='integer' name='[Calculation_0680380214267910]' role='measure' type='quantitative' user:unnamed='Sheet 5'>
              <calculation class='tableau' formula='-SUM([Calculation_0680380208738304])' />
            </column>
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
            <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0680380209315841]' derivation='User' name='[usr:Calculation_0680380209315841:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0680380214267910]' derivation='User' name='[usr:Calculation_0680380214267910:qk]' pivot='key' type='quantitative' />
