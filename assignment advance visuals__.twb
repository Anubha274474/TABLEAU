            <column-instance column='[AdmissionDate]' derivation='Month' name='[mn:AdmissionDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
